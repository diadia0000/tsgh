<mxfile host="app.diagrams.net">
  <diagram name="方案4: UNet++ HED 輸入通道" id="unet_hed">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" background="#000000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Title -->
        <mxCell id="title" value="方案 4: UNet++ 使用 HED 輸入通道 (需重新訓練)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        
        <!-- ===== TRAINING PIPELINE ===== -->
        <mxCell id="train_section" value="訓練階段" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1200" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Training Input -->
        <mxCell id="train_input" value="&lt;b&gt;HER2 RGB 圖片&lt;/b&gt;&lt;br&gt;1024×1024×3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#4a90d9;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="140" height="70" as="geometry"/>
        </mxCell>
        
        <!-- HED Conversion -->
        <mxCell id="hed_convert" value="&lt;b&gt;RGB → HED 轉換&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4a90d9&quot;&gt;H: Hematoxylin (藍核)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ff9999&quot;&gt;E: Eosin (紅色)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#d4a838&quot;&gt;D: DAB (棕色膜)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;skimage.color.rgb2hed()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="220" y="135" width="180" height="130" as="geometry"/>
        </mxCell>
        
        <!-- HED Output -->
        <mxCell id="hed_output" value="&lt;b&gt;HED 輸入&lt;/b&gt;&lt;br&gt;1024×1024×3&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#aaaaaa&quot;&gt;染色已分離&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="140" height="90" as="geometry"/>
        </mxCell>
        
        <!-- UNet++ Model -->
        <mxCell id="unet" value="&lt;b&gt;UNet++ (DenseNet121)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Input: HED 3 通道&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;Output: 2 類別&lt;/font&gt;&lt;br&gt;• 0 = 非膜&lt;br&gt;• 1 = 咖啡色膜&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#aaaaaa&quot;&gt;網路直接在 D 通道&lt;br&gt;學習膜分割&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c4a1f;strokeColor=#d4a838;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="180" height="150" as="geometry"/>
        </mxCell>
        
        <!-- Ground Truth -->
        <mxCell id="gt" value="&lt;b&gt;Ground Truth Mask&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#aaaaaa&quot;&gt;人工標註或&lt;br&gt;K-Means 生成&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="620" y="310" width="180" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Loss -->
        <mxCell id="loss" value="&lt;b&gt;Loss Function&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dice + CE Loss&lt;br&gt;&lt;font color=&quot;#aaaaaa&quot;&gt;Class Weights: [0.5, 2.0]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="850" y="180" width="180" height="90" as="geometry"/>
        </mxCell>
        
        <!-- Model Output -->
        <mxCell id="model_save" value="&lt;b&gt;訓練完成模型&lt;/b&gt;&lt;br&gt;&lt;br&gt;her2_hed_unet.pth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4d1f;strokeColor=#4ad94a;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1080" y="180" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Training Arrows -->
        <mxCell id="ta1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="train_input" target="hed_convert">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ta2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="hed_convert" target="hed_output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ta3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="hed_output" target="unet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ta4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="gt" target="unet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ta5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="unet" target="loss">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ta6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="loss" target="model_save">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- ===== INFERENCE PIPELINE ===== -->
        <mxCell id="infer_section" value="推論階段" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1d3a1d;strokeColor=#82b366;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1200" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Inference Input -->
        <mxCell id="infer_input" value="&lt;b&gt;新 HER2 圖片&lt;/b&gt;&lt;br&gt;RGB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#4a90d9;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="140" height="70" as="geometry"/>
        </mxCell>
        
        <!-- Inference HED -->
        <mxCell id="infer_hed" value="&lt;b&gt;RGB → HED&lt;/b&gt;&lt;br&gt;&lt;br&gt;自動轉換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="220" y="495" width="140" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Load Model -->
        <mxCell id="load_model" value="&lt;b&gt;載入模型&lt;/b&gt;&lt;br&gt;&lt;br&gt;her2_hed_unet.pth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c4a1f;strokeColor=#d4a838;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="400" y="495" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Inference -->
        <mxCell id="infer_run" value="&lt;b&gt;UNet++ 推論&lt;/b&gt;&lt;br&gt;&lt;br&gt;model.eval()&lt;br&gt;with torch.no_grad()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c4a1f;strokeColor=#d4a838;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="600" y="495" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Mask Output -->
        <mxCell id="mask_out" value="&lt;b&gt;咖啡色膜 Mask&lt;/b&gt;&lt;br&gt;&lt;br&gt;Argmax (0-1)&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;精確分離&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4d1f;strokeColor=#4ad94a;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="800" y="495" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Apply Mask -->
        <mxCell id="apply_mask" value="&lt;b&gt;排除膜區域&lt;/b&gt;&lt;br&gt;&lt;br&gt;膜 → 黑色&lt;br&gt;→ 與 Dish 融合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4d1f;strokeColor=#4ad94a;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1000" y="495" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Inference Arrows -->
        <mxCell id="ia1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="infer_input" target="infer_hed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ia2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="infer_hed" target="load_model">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ia3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="load_model" target="infer_run">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ia4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="infer_run" target="mask_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ia5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="mask_out" target="apply_mask">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- ===== KEY INSIGHT ===== -->
        <mxCell id="insight_title" value="核心概念: HED 色彩分離" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="400" height="35" as="geometry"/>
        </mxCell>
        
        <mxCell id="hed_diagram" value="&lt;b&gt;HED (Hematoxylin-Eosin-DAB) 色彩空間&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4a90d9&quot;&gt;H 通道 (Hematoxylin):&lt;/font&gt;&lt;br&gt;  → 藍色細胞核&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#ff9999&quot;&gt;E 通道 (Eosin):&lt;/font&gt;&lt;br&gt;  → 紅色染色 (通常不用)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d4a838&quot;&gt;D 通道 (DAB):&lt;/font&gt;&lt;br&gt;  → &lt;font color=&quot;#00ff00&quot;&gt;&lt;b&gt;咖啡色細胞膜 (目標!)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#aaaaaa&quot;&gt;UNet++ 直接在已分離的通道上學習&lt;br&gt;自動學會利用 D 通道，忽略 H 通道&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="400" height="220" as="geometry"/>
        </mxCell>
        
        <!-- Pros/Cons -->
        <mxCell id="pros" value="&lt;b&gt;✅ 優點&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 最精確的分割效果&lt;br&gt;• 網路自動學習染色特徵&lt;br&gt;• H 通道自然排除藍色核&lt;br&gt;• 對不同染色強度穩健&lt;br&gt;• 可泛化到新圖片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d3a1d;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="665" width="260" height="150" as="geometry"/>
        </mxCell>
        
        <mxCell id="cons" value="&lt;b&gt;⚠️ 缺點&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 需要重新訓練模型&lt;br&gt;• 需要 Ground Truth Mask&lt;br&gt;• 訓練時間較長&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;建議: 用 K-Means 生成 GT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="665" width="260" height="150" as="geometry"/>
        </mxCell>
        
        <!-- Implementation Steps -->
        <mxCell id="impl" value="&lt;b&gt;實作步驟&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 修改 dataset.py:&lt;br&gt;   img = rgb2hed(img)&lt;br&gt;&lt;br&gt;2. 修改 config.py:&lt;br&gt;   INPUT_CHANNELS = 3 (HED)&lt;br&gt;&lt;br&gt;3. 重新訓練模型&lt;br&gt;&lt;br&gt;4. 推論時也使用 HED 輸入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1080" y="620" width="200" height="200" as="geometry"/>
        </mxCell>
        
        <!-- Comparison with RGB -->
        <mxCell id="compare" value="&lt;b&gt;RGB vs HED 輸入比較&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#ff6666&quot;&gt;RGB: 棕/藍混合在 R,G,B 各通道&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;HED: 棕色獨立在 D 通道&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;     藍色獨立在 H 通道&lt;/font&gt;&lt;br&gt;&lt;br&gt;→ HED 讓網路更容易學習分離!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="840" width="300" height="120" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
