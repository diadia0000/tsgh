<mxfile host="app.diagrams.net">
  <diagram name="推論流程" id="inference">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" background="#000000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <mxCell id="title" value="推論核心流程 (二分類 + Cellpose 整合)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="500" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Steps -->
        <mxCell id="load" value="1. Load Model&lt;br&gt;&lt;br&gt;Load Weights&lt;br&gt;Eval Mode&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;(2-class model)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d3a1d;strokeColor=#82b366;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="120" as="geometry"/>
        </mxCell>
        
        <mxCell id="input" value="2. Process Input&lt;br&gt;&lt;br&gt;Read HER2 Image&lt;br&gt;Normalize/Tensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d3a1d;strokeColor=#82b366;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="160" height="120" as="geometry"/>
        </mxCell>
        
        <mxCell id="predict" value="3. Prediction&lt;br&gt;&lt;br&gt;Model Inference&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;Argmax (0-1)&lt;/font&gt;&lt;br&gt;咖啡色膜 Mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="160" height="120" as="geometry"/>
        </mxCell>
        
        <mxCell id="mask_apply" value="4. Apply Mask&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;排除咖啡色膜區域&lt;/font&gt;&lt;br&gt;膜區域 → 黑色/透明&lt;br&gt;保留非膜區域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="180" height="120" as="geometry"/>
        </mxCell>
        
        <mxCell id="merge" value="5. Merge with Dish&lt;br&gt;&lt;br&gt;HER2 處理後圖片&lt;br&gt;+ Dish 圖片&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;→ 融合圖片&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="180" height="120" as="geometry"/>
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="load" target="input">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="input" target="predict">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="predict" target="mask_apply">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="mask_apply" target="merge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Cellpose Integration -->
        <mxCell id="cellpose" value="&lt;b&gt;&lt;font color=&quot;#00ff00&quot;&gt;6. Cellpose 細胞分離&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;融合圖片 → Cellpose&lt;br&gt;Instance Segmentation&lt;br&gt;輸出: 個別細胞 Mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3d5c;strokeColor=#4d9de0;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="260" height="120" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="merge" target="cellpose">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="290"/>
              <mxPoint x="680" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Output -->
        <mxCell id="output" value="&lt;b&gt;最終輸出&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 個別細胞分離結果&lt;br&gt;• 可用於後續紅黑點分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="260" height="100" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="cellpose" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Note -->
        <mxCell id="note" value="&lt;b&gt;職責分離&lt;/b&gt;&lt;br&gt;&lt;br&gt;• UNet++: 專注分離咖啡色膜&lt;br&gt;• Cellpose: 專注細胞實例分割&lt;br&gt;• 各司其職，減少累積誤差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;fontSize=12;fontColor=#FFFFFF;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="320" width="240" height="120" as="geometry"/>
        </mxCell>
        
        <!-- Batch Info -->
        <mxCell id="batch" value="* 支援批量處理 (tqdm 進度條) | 推論時決定 mask 區域的處理方式" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="250" y="620" width="600" height="30" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
