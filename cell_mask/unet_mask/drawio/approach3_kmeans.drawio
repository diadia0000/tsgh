<mxfile host="65bd71144e">
    <diagram name="方案3: 細胞核為中心膜偵測 (Nucleus-Based)" id="nucleus_based">
        <mxGraphModel dx="1249" dy="694" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#000000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="方案 3: 細胞核為中心膜偵測 (Nucleus-Based)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="300" y="20" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="input" value="&lt;b&gt;HER2 RGB 圖片&lt;/b&gt;&lt;br&gt;1024×1024×3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#4a90d9;strokeWidth=2;fontSize=14;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="step1" value="&lt;b&gt;1. RGB → HED 轉換&lt;/b&gt;&lt;br&gt;&lt;br&gt;H: Hematoxylin (藍紫)&lt;br&gt;E: Eosin (粉紅)&lt;br&gt;D: DAB (棕色)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="280" y="100" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="step2" value="&lt;b&gt;2. 偵測細胞核&lt;/b&gt;&lt;br&gt;&lt;br&gt;H 通道 &amp;gt; Otsu 閾值&lt;br&gt;→ 藍色細胞核 Mask&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4a90d9&quot;&gt;藍色區域 = 細胞核&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#4a90d9;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="540" y="90" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="step3" value="&lt;b&gt;3. 膨脹生成膜環&lt;/b&gt;&lt;br&gt;&lt;br&gt;dilate(nuclei, disk(5))&lt;br&gt;- nuclei&lt;br&gt;= 膜環區域&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;膜一定在核周圍&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4d1f;strokeColor=#4ad94a;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="800" y="90" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="step4" value="&lt;b&gt;4. 膜環中偵測 DAB&lt;/b&gt;&lt;br&gt;&lt;br&gt;在膜環區域內：&lt;br&gt;D 通道 &amp;gt; Otsu 閾值&lt;br&gt;→ 棕色膜 Mask&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d4a838&quot;&gt;只看膜環內的棕色&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c4a1f;strokeColor=#d4a838;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="90" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="step5" value="&lt;b&gt;5. 形態學後處理&lt;/b&gt;&lt;br&gt;&lt;br&gt;• binary_closing&lt;br&gt;• remove_small_objects&lt;br&gt;• remove_small_holes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4d1f;strokeColor=#4ad94a;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="800" y="290" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="output" value="&lt;b&gt;咖啡色膜 Mask&lt;/b&gt;&lt;br&gt;(0-1 二分類)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;✓ 生物學合理&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;✓ 不會遺漏淺色膜&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#4a90d9;strokeWidth=2;fontSize=14;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="500" y="280" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="input" target="step1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="step1" target="step2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="step2" target="step3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="step3" target="step4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="step4" target="step5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1160" y="260"/>
                            <mxPoint x="900" y="260"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="step5" target="output" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pros" value="&lt;b&gt;✅ 優點&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 生物學合理 (膜在核周圍)&lt;br&gt;• 不會遺漏淺色膜&lt;br&gt;• Otsu 自適應閾值&lt;br&gt;• 可調整膜環寬度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d3a1d;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="460" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="cons" value="&lt;b&gt;⚠️ 注意事項&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 需要準確偵測到細胞核&lt;br&gt;• 膜環寬度需調整&lt;br&gt;• 對無核區域無效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="320" y="460" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="diagram" value="&lt;b&gt;示意圖&lt;/b&gt;&lt;br&gt;&lt;br&gt;○ = 細胞核 (藍色)&lt;br&gt;◐ = 膜環區域 (綠色)&lt;br&gt;● = 膜環中的 DAB 區域 (紅色)&lt;br&gt;&lt;br&gt;          ◐◐◐◐&lt;br&gt;        ◐◐○○◐◐&lt;br&gt;        ◐○○○○◐&lt;br&gt;        ◐◐○○◐◐&lt;br&gt;          ◐◐◐◐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;strokeWidth=2;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="460" width="220" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="code" value="&lt;b&gt;偽代碼&lt;/b&gt;&lt;br&gt;&lt;br&gt;hed = rgb2hed(img)&lt;br&gt;&lt;br&gt;# 1. 找細胞核&lt;br&gt;nuclei = hed[:,:,0] &amp;gt; otsu(H)&lt;br&gt;&lt;br&gt;# 2. 膨脹得膜環&lt;br&gt;ring = dilate(nuclei) - nuclei&lt;br&gt;&lt;br&gt;# 3. 在膜環中找 DAB&lt;br&gt;membrane = ring &amp;amp; (hed[:,:,2] &amp;gt; otsu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;spacingLeft=10;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="860" y="460" width="300" height="200" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>