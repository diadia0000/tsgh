                <mxCell id="inference_module" value="推論模組 (關鍵變更)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;fontSize=16;fontStyle=1;align=center;fontColor=#FFFFFF;" parent="1" vertex="1">
