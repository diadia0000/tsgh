                </mxCell>
                <mxCell id="inference" value="&lt;b&gt;inference.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;load_model()&lt;/b&gt;&lt;br&gt;- 載入訓練好的 checkpoint&lt;br&gt;- 模型權重恢復&lt;br&gt;&lt;br&gt;&lt;b&gt;predict_single()&lt;/b&gt;&lt;br&gt;- 單張影像推論&lt;br&gt;- 預處理和後處理&lt;br&gt;&lt;br&gt;&lt;b&gt;batch_inference()&lt;/b&gt;&lt;br&gt;- 批量推論&lt;br&gt;- 進度條顯示&lt;br&gt;&lt;br&gt;&lt;b&gt;apply_mask_to_image()&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;- 將咖啡色膜區域從 HER2 圖片排除&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;- 輸出可用於 Dish 融合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="300" y="755" width="290" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="model_output" value="&lt;b&gt;模型輸出&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;models/&lt;/b&gt;&lt;br&gt;- checkpoint_epochXXX_val_miou_X.XXXX.pth&lt;br&gt;- 保存最佳 K 個模型&lt;br&gt;&lt;br&gt;&lt;b&gt;logs/&lt;/b&gt;&lt;br&gt;- 訓練日誌&lt;br&gt;- 指標記錄&lt;br&gt;&lt;br&gt;&lt;b&gt;inference_output/&lt;/b&gt;&lt;br&gt;- 咖啡色膜 Mask&lt;br&gt;- 處理後的 HER2 圖片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
