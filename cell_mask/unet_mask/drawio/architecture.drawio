                <mxCell id="train" value="&lt;b&gt;train.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;create_model()&lt;/b&gt;&lt;br&gt;- Unet++ (SMP)&lt;br&gt;- DenseNet121 編碼器&lt;br&gt;- ImageNet 預訓練&lt;br&gt;&lt;b&gt;- classes=2 (二分類)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;train_one_epoch()&lt;/b&gt;&lt;br&gt;- 梯度累積&lt;br&gt;- AMP 混合精度&lt;br&gt;- 指標計算&lt;br&gt;&lt;br&gt;&lt;b&gt;validate()&lt;/b&gt;&lt;br&gt;- 驗證集評估&lt;br&gt;- mIoU, Dice Score&lt;br&gt;&lt;br&gt;&lt;b&gt;train()&lt;/b&gt;&lt;br&gt;- 主訓練流程&lt;br&gt;- 早停機制&lt;br&gt;- 模型保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="340" width="200" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="utils" value="&lt;b&gt;utils.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;損失函數:&lt;/b&gt;&lt;br&gt;- DiceLoss&lt;br&gt;- CombinedLoss (Dice + CE)&lt;br&gt;&lt;br&gt;&lt;b&gt;評估指標:&lt;/b&gt;&lt;br&gt;- compute_iou()&lt;br&gt;- compute_dice_score()&lt;br&gt;&lt;br&gt;&lt;b&gt;工具類:&lt;/b&gt;&lt;br&gt;- MetricsTracker&lt;br&gt;- CheckpointManager&lt;br&gt;- TrainingLogger&lt;br&gt;- TeeLogger&lt;br&gt;&lt;br&gt;&lt;b&gt;其他:&lt;/b&gt;&lt;br&gt;- clear_cuda_cache()&lt;br&gt;- EarlyStopping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
