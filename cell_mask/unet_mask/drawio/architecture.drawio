                <mxCell id="arrow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#FFFFFF;" parent="1" source="inference" target="model_output" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="model_arch" value="&lt;b&gt;模型架構 (二分類)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Unet++&lt;/b&gt;&lt;br&gt;編碼器: DenseNet121&lt;br&gt;預訓練: ImageNet&lt;br&gt;輸入: 1024×1024 RGB&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;&lt;b&gt;輸出: 2 類別 (0=非膜, 1=膜)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;優化器:&lt;/b&gt; AdamW&lt;br&gt;&lt;b&gt;調度器:&lt;/b&gt; CosineAnnealingLR&lt;br&gt;&lt;b&gt;損失:&lt;/b&gt; Dice + CE&lt;br&gt;&lt;b&gt;指標:&lt;/b&gt; mIoU, Dice Score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3d5c;strokeColor=#4d9de0;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="900" y="770" width="180" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="hardware" value="&lt;b&gt;硬體優化&lt;/b&gt;&lt;br&gt;&lt;br&gt;NVIDIA RTX 5090 32GB&lt;br&gt;Intel Ultra 265K&lt;br&gt;64GB RAM&lt;br&gt;&lt;br&gt;- AMP 混合精度訓練&lt;br&gt;- pin_memory=True&lt;br&gt;- num_workers=16&lt;br&gt;- 梯度累積 (4 步)&lt;br&gt;- 有效 batch size = 24&lt;br&gt;- CUDA 顯存清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1a1a;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="100" width="200" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="labels" value="&lt;b&gt;類別定義 (簡化)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;&lt;b&gt;0: 非細胞膜 (背景+內部)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;&lt;b&gt;1: 咖啡色細胞膜 (HER2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;類別權重: [0.5, 2.0]&lt;br&gt;&lt;br&gt;&lt;b&gt;優勢:&lt;/b&gt;&lt;br&gt;- 專注單一任務&lt;br&gt;- 減少模型複雜度&lt;br&gt;- 更穩定的收斂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d3a1d;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="360" width="200" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="workflow" value="&lt;b&gt;新訓練工作流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 生成二分類 Pseudo Mask&lt;br&gt;   dataset_generator.py&lt;br&gt;&lt;br&gt;2. 訓練二分類模型&lt;br&gt;   train.py (classes=2)&lt;br&gt;&lt;br&gt;3. 推論 → 咖啡色膜 Mask&lt;br&gt;   inference.py&lt;br&gt;&lt;br&gt;4. 排除膜區域 → 融合 Dish&lt;br&gt;   &lt;font color=&quot;#00ff00&quot;&gt;交給 Cellpose 處理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="600" width="200" height="210" as="geometry"/>
                </mxCell>
