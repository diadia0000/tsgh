<mxfile host="app.diagrams.net">
  <diagram name="數據處理" id="data">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" background="#000000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <mxCell id="title" value="Pseudo Mask 生成流程 (二分類簡化版)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="500" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Steps -->
        <mxCell id="input" value="HER2 原始影像&lt;br&gt;(RGB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="160" height="100" as="geometry"/>
        </mxCell>
        
        <mxCell id="step1" value="OD 空間轉換&lt;br&gt;&amp;&lt;br&gt;Color Deconvolution&lt;br&gt;(her2_mask.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="180" height="100" as="geometry"/>
        </mxCell>
        
        <mxCell id="step2" value="&lt;font color=&quot;#00ff00&quot;&gt;&lt;b&gt;簡化邏輯 (二分類)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;咖啡色膜(1) / 非膜(0)&lt;br&gt;(membrane_seg.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2453;strokeColor=#9673a6;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="180" height="100" as="geometry"/>
        </mxCell>
        
        <mxCell id="output" value="Pseudo Mask&lt;br&gt;(0-1 二分類 PNG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2a2a;strokeColor=#999999;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="160" height="100" as="geometry"/>
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="input" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#FFFFFF;" edge="1" parent="1" source="step2" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Key Utils -->
        <mxCell id="utils" value="&lt;b&gt;簡化核心邏輯 (二分類)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;1. DAB &amp;gt; 閾值 → 咖啡色膜 (1)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;2. 其餘 → 非膜 (0)&lt;/font&gt;&lt;br&gt;3. 移除小雜訊&lt;br&gt;&lt;br&gt;&lt;b&gt;優勢:&lt;/b&gt; 不需要區分膜內部/背景，讓模型專注在咖啡色膜分離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3d5c;strokeColor=#4d9de0;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="500" height="120" as="geometry"/>
        </mxCell>
        
        <!-- Comparison -->
        <mxCell id="compare" value="&lt;b&gt;變更對比&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#ff6666&quot;&gt;舊: 膜(2) / 內部(1) / 背景(0) = 3分類&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;新: 咖啡色膜(1) / 非膜(0) = 2分類&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4000;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="250" y="430" width="500" height="80" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
